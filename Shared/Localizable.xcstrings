{"sourceLanguage":"en","version":"1.0","strings":{
  "app.name": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Litter Box Tracker"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "猫砂盆提醒"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "貓砂盆提醒"}}}},
