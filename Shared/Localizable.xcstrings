  "compare.different": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The boxes or trial conditions differ. Read the scores in context."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "猫砂盆或试用条件不同，请结合各自条件看分数。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "貓砂盆或試用條件不同，請搭配各自條件看分數。"}}}},
