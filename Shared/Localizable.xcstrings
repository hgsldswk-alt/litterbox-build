  "backup.help": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The backup includes your households, boxes, trials and full history. Keep it somewhere private."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "备份含家庭、猫砂盆、试用和完整历史，请保存到私密位置。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "備份含家庭、貓砂盆、試用和完整紀錄，請存放在私密位置。"}}}},
